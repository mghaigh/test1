    "description": "The Loan of a specific Media Copy",
    "title": "Loan",
    "type": "object",
    "properties": {
        "date_borrowed": {
            "type": "string"
        },
        "date_returned": {
            "type": "string"
        },
        "borrower": {
            "description": "The URI of a Borrower object",
